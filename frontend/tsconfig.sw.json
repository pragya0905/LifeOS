{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sw.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "WebWorker"],
    "types": [],
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "module": "esnext",
    "moduleDetection": "force",
    "noEmit": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/sw.ts"]
}
